                        android:layout_marginStart="8dp"
                        android:text="প্রসেস করা ভিডিও তুলনা করুন অরিজিনালের সাথে"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/text_muted"
                    android:alpha="0.2"
                    android:layout_marginBottom="16dp"/>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- WARNING SECTION -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ সতর্কতা ও দায়বদ্ধতা"
                    android:textColor="#FFC107"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Warning Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_warning_box"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <!-- Warning 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛔"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="এই অ্যাপ শুধুমাত্র শিক্ষামূলক ও ব্যক্তিগত ব্যবহারের জন্য।"
                            android:textColor="#FFCC80"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Warning 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛔"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="অন্যের কপিরাইটেড কন্টেন্ট চুরি করা বেআইনি।"
                            android:textColor="#FFCC80"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Warning 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛔"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="শুধুমাত্র নিজের তৈরি বা লাইসেন্সপ্রাপ্ত কন্টেন্ট ব্যবহার করুন।"
                            android:textColor="#FFCC80"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Warning 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛔"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="0dp"
