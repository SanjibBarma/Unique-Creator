                    android:startY="3"
                    android:endX="24"
                    android:endY="56"
                    android:type="linear">
                    <item android:color="#9D94FF" android:offset="0.0"/>
                    <item android:color="#6C63FF" android:offset="1.0"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Shield Inner (Lighter for contrast) -->
        <path
            android:pathData="M24,8L8,15L8,29C8,38 15,47 24,50C33,47 40,38 40,29L40,15L24,8Z"
            android:fillColor="#2A2A4A"/>

