        <!-- Cross/Slash Line (Bright Vibrant Red) -->
        <path
            android:pathData="M16,20L32,36"
            android:strokeWidth="3.5"
            android:strokeColor="#FF4D4D"
            android:strokeLineCap="round"/>

    </group>
